{
  "name": "dsh-compose-studio",
  "version": "0.1.0",
  "description": "Visual drag-and-drop editor for Jetpack Compose, inside DSH (DeepSeek Harness)",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/invariant.d.ts",
  "exports": {
    ".": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/cordis-plugin-group": "~1.1.0",
    "@deepseek-ai/cordis-plugin-include": "^1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "^1.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-anonymous-user-id": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-atomic-write": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-brand": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-code-runtime": "^0.1.5-rc.3",
    "@deepseek-ai/dsh-command-feedback": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-cordis-host-runner": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-file-reference": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-plugin-inventory": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm-retry": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-message-feedback": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-output-retention": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-reference": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session-title": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-spill": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-storage": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-timeout": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-modules": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.2.2-rc.1",
    "react": "^18.3.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "compose",
    "jetpack-compose",
    "visual-editor",
    "material3"
  ],
  "license": "MIT",
  "private": true
}
